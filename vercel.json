{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thewebx.in" }],
      "destination": "https://www.thewebxstudio.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.thewebx.in" }],
      "destination": "https://www.thewebxstudio.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thewebxstudio.com" }],
      "destination": "https://www.thewebxstudio.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/case-study-nova-finance",
      "destination": "/work",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(images|video)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.(png|ico|svg|webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(assets/(.*)|nav\\.js|footer\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
