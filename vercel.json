{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thewebx.in" }],
      "destination": "https://www.thewebxstudio.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.thewebx.in" }],
      "destination": "https://www.thewebxstudio.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thewebxstudio.com" }],
      "destination": "https://www.thewebxstudio.com/:path*",
      "statusCode": 301
    }
  ]
}
